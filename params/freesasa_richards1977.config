# FreeSASA classifier configuration
# Radii source: Richards, F. M. (1977). Areas, volumes, packing, and protein structure.
# Atom-type <-> functional-group mapping: SIDECHAINS/BACKBONE dict
#   ch4 = tetrahedral (sp3) aliphatic carbon      | ch3 = trigonal (sp2) carbon (aromatic/carbonyl)
#   nh4 = tetrahedral/charged nitrogen (cation_N) | nh3 = trigonal/uncharged nitrogen (amide_N)
#   oh4 = tetrahedral hydroxyl oxygen             | oh3 = trigonal carbonyl/anion oxygen
#   sh  = cysteine thiol sulfur                   | st  = methionine thioether sulfur
#   zn/fe = metal ions (own radius; class defaulted to apolar — see notes)
#
# NOTE: FreeSASA's current parser only allows the class 'polar' or 'apolar' per type
# NOTE: 'ANY' is the real FreeSASA wildcard keyword for atoms shared across all


name: richards1977

types:
    ch4  2.00  apolar
    ch3  1.70  apolar
    nh4  2.00  polar
    nh3  1.70  polar
    oh4  1.60  polar
    oh3  1.50  polar
    sh   2.00  polar
    st   1.80  polar
    zn   0.64  polar
    fe   0.64  polar

atoms:
    # --- backbone (all residues) ---
    ANY  N    nh3
    ANY  CA   ch4
    ANY  C    ch3
    ANY  O    oh3
    ANY  OXT  oh3
    ANY  OC1  oh3   # alias: GROMACS naming for C-terminal carboxylate O 
    ANY  OC2  oh3   # alias: GROMACS naming for C-terminal carboxylate O 
    ANY  OT1  oh3   # alias: CHARMM naming for C-terminal carboxylate O (= O)
    ANY  OT2  oh3   # alias: CHARMM naming for C-terminal carboxylate O (= OXT)
    

    # --- sidechains ---
    ALA  CB   ch4

    VAL  CB   ch4 
    VAL  CG1  ch4
    VAL  CG2  ch4

    LEU  CB   ch4 
    LEU  CG   ch4
    LEU  CD1  ch4
    LEU  CD2  ch4

    ILE  CB   ch4 
    ILE  CG1  ch4
    ILE  CG2  ch4
    ILE  CD1  ch4
    ILE  CD   ch4   ## alias: GROMACS/CHARMM-prepped PDBs often use CD instead of CD1

    PRO  CB   ch4 
    PRO  CG   ch4
    PRO  CD   ch4

    SER  CB   ch4 
    SER  OG   oh4 # 

    THR  CB   ch4 
    THR  OG1  oh4
    THR  CG2  ch4

    CYS  CB   ch4 
    CYS  SG   sh

    MET  CB   ch4
    MET  CG   ch4
    MET  SD   st
    MET  CE   ch4

    MSE  CB   ch4
    MSE  CG   ch4
    MSE  SD   st
    MSE  CE   ch4

    ASP  CB   ch4
    ASP  CG   ch3 #
    ASP  OD1  oh3
    ASP  OD2  oh3

    GLU  CB   ch4 
    GLU  CG   ch4
    GLU  CD   ch3
    GLU  OE1  oh3
    GLU  OE2  oh3

    ASN  CB   ch4
    ASN  CG   ch3 #
    ASN  OD1  oh3
    ASN  ND2  nh3

    GLN  CB   ch4 
    GLN  CG   ch4
    GLN  CD   ch3
    GLN  OE1  oh3
    GLN  NE2  nh3

    LYS  CB   ch4 
    LYS  CG   ch4
    LYS  CD   ch4
    LYS  CE   ch4
    LYS  NZ   nh4

    ARG  CB   ch4
    ARG  CG   ch4
    ARG  CD   ch4
    ARG  NE   nh4 
    ARG  CZ   ch3 #
    ARG  NH1  nh3 #
    ARG  NH2  nh3 #

    PHE  CB   ch4 
    PHE  CG   ch3
    PHE  CD1  ch3
    PHE  CD2  ch3
    PHE  CE1  ch3
    PHE  CE2  ch3
    PHE  CZ   ch3

    TYR  CB   ch4 
    TYR  CG   ch3
    TYR  CD1  ch3
    TYR  CD2  ch3
    TYR  CE1  ch3
    TYR  CE2  ch3
    TYR  CZ   ch3
    TYR  OH   oh4

    TRP  CB   ch4 
    TRP  CG   ch3
    TRP  CD1  ch3
    TRP  CD2  ch3
    TRP  NE1  nh3
    TRP  CE2  ch3
    TRP  CE3  ch3
    TRP  CZ2  ch3
    TRP  CZ3  ch3
    TRP  CH2  ch3

    HIS  CB   ch4 
    HIS  CG   ch3
    HIS  ND1  nh3
    HIS  CD2  ch3
    HIS  CE1  ch3
    HIS  NE2  nh3

    HSD  CB   ch4 
    HSD  CG   ch3
    HSD  ND1  nh3
    HSD  CD2  ch3
    HSD  CE1  ch3
    HSD  NE2  nh3

    # --- hetero / other ---
    ZN   ZN   zn
    FE   FE   fe
